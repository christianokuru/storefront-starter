{
	"name": "storefront-starter",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev -p 3001",
		"build": "next build",
		"start": "next start -p 3001",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
