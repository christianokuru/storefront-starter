/**
 * Storefront Worker. Build-time vars (NEXT_PUBLIC_*) are read from .env / CI at build time.
 * The engine must allow this storefront's origin: STORE_CORS=https://your-storefront on the engine.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "storefront-starter",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
	"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "storefront-starter" }],
	"observability": { "enabled": true }
}
