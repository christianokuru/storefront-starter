		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.76.0",
		"next": "16.4.5",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"server-only": "^0.0.1",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9",
		"eslint-config-next": "16.4.5",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"wrangler": "^4.134.0"
	}
